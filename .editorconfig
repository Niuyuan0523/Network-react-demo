# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

# 所有文件的默认配置
[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# HTML 文件配置
[*.html]
indent_style = space
indent_size = 2

# JSX/TSX 文件配置
[*.{jsx,tsx}]
indent_style = space
indent_size = 2

# JavaScript/TypeScript 文件配置
[*.{js,ts}]
indent_style = space
indent_size = 2

# CSS 相关文件配置
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# JSON 文件配置
[*.json]
indent_style = space
indent_size = 2

# Markdown 文件配置
[*.md]
trim_trailing_whitespace = false
